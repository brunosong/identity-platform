<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>
    <parent>
        <groupId>com.brunosong</groupId>
        <artifactId>identity-platform</artifactId>
        <version>0.0.1-SNAPSHOT</version>
    </parent>

    <artifactId>auth-service</artifactId>
    <packaging>pom</packaging>
    <name>auth-service</name>
    <description>auth-service</description>

    <properties>
        <!-- dataaccess 와 bootstrap 의 통합 테스트가 같은 버전을 쓴다. -->
        <testcontainers.version>1.21.4</testcontainers.version>
    </properties>

    <!--
      헥사고날 레이어 모듈을 묶어 빌드 순서만 잡는 집계자(jar 아님).
      auth-bootstrap 만 실행 가능한 모듈이고, 나머지는 그것이 묶는 레이어다.
    -->
    <modules>
        <module>auth-domain</module>
        <module>auth-application</module>
        <module>auth-dataaccess</module>
        <module>auth-web</module>
        <module>auth-messaging</module>
        <module>auth-bootstrap</module>
    </modules>

</project>
