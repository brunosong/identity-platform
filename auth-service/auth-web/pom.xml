<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>
    <parent>
        <groupId>com.brunosong</groupId>
        <artifactId>auth-service</artifactId>
        <version>0.0.1-SNAPSHOT</version>
        <relativePath>../pom.xml</relativePath>
    </parent>

    <artifactId>auth-web</artifactId>

    <!--
      web(인바운드 어댑터) 계층.
      컨트롤러 / 요청·응답 모델. application 의 유스케이스(port.in)만 의존한다.
    -->

    <dependencies>
        <dependency>
            <groupId>com.brunosong</groupId>
            <artifactId>auth-application</artifactId>
            <version>${project.version}</version>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-web</artifactId>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-validation</artifactId>
        </dependency>
        <!--
          서버가 직접 그리는 화면(로그인, 운영 콘솔)용. auth 는 게이트웨이 뒤의 API 가 아니라
          자기 화면을 들고 혼자 서는 서비스라, 화면을 남의 앱에 맡기지 않는다.
        -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-thymeleaf</artifactId>
        </dependency>
        <!--
          auth 가 받는 토큰을 검증하고 들여보내는 일만 맡긴다(리소스 서버). 토큰 발급과 로그인 화면은
          직접 만든 것을 그대로 쓴다. customer-service, order-service 와 같은 스타터다.
        -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-oauth2-resource-server</artifactId>
        </dependency>
    </dependencies>

</project>
