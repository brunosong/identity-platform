<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>
    <parent>
        <groupId>com.brunosong</groupId>
        <artifactId>auth-service</artifactId>
        <version>0.0.1-SNAPSHOT</version>
        <relativePath>../pom.xml</relativePath>
    </parent>

    <artifactId>auth-dataaccess</artifactId>

    <!--
      DB 접근 전용 계층.
      영속 엔티티 / 리포지토리 / 영속성 어댑터(application port.out 구현).
      도메인<->영속모델 매핑은 이 레이어 안에서.
    -->

    <dependencies>
        <dependency>
            <groupId>com.brunosong</groupId>
            <artifactId>auth-application</artifactId>
            <version>${project.version}</version>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-data-jpa</artifactId>
        </dependency>
        <!--
          스키마 마이그레이션. 스크립트(db/migration)도 이 모듈이 소유한다 — 엔티티를 바꾸는 커밋과
          스키마를 바꾸는 커밋이 갈라지면 안 된다.

          Boot 3 은 flyway-core 만 있으면 자동설정이 함께 온다. (Boot 4 는 자동설정이 기능별 모듈로
          쪼개져 있어 spring-boot-flyway 를 따로 넣어야 하고, 빠뜨리면 마이그레이션이 조용히 지나간 뒤
          ddl-auto=validate 에서 "missing table" 로 터진다.)
        -->
        <dependency>
            <groupId>org.flywaydb</groupId>
            <artifactId>flyway-core</artifactId>
        </dependency>
        <dependency>
            <groupId>org.flywaydb</groupId>
            <artifactId>flyway-database-postgresql</artifactId>
        </dependency>
        <!-- PasswordEncoder(BCrypt) 어댑터 — 로컬 자격증명 -->
        <dependency>
            <groupId>org.springframework.security</groupId>
            <artifactId>spring-security-crypto</artifactId>
        </dependency>

        <dependency>
            <groupId>org.testcontainers</groupId>
            <artifactId>postgresql</artifactId>
            <version>${testcontainers.version}</version>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.testcontainers</groupId>
            <artifactId>junit-jupiter</artifactId>
            <version>${testcontainers.version}</version>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.postgresql</groupId>
            <artifactId>postgresql</artifactId>
            <scope>test</scope>
        </dependency>
    </dependencies>

</project>
